# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Get every value by running /costar-keys in the track Discord.

# Matterport Model API (GraphQL at api.matterport.com/api/models/graph).
# HTTP basic auth: the key is the user name, the token is the password.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=

# Matterport Showcase SDK. The hackathon key only works from localhost.
MATTERPORT_SDK_KEY=

# Vexcel imagery API. Sent as the X-API-KEY header. Houston and Los Angeles only.
VEXCEL_API_KEY=

# CoStar data kit: a password-protected zip.
# Set the password, plus either the download link or the path to the downloaded zip.
COSTAR_ZIP_PASSWORD=
COSTAR_KIT_URL=
COSTAR_KIT_ZIP=
