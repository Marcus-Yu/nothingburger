# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Get every value by running /costar-keys in the track Discord.

# Matterport Model API (GraphQL at api.matterport.com/api/models/graph).
# HTTP basic auth: the key is the user name, the token is the password.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=

# Matterport Showcase SDK. The hackathon key only works from localhost.
MATTERPORT_SDK_KEY=

# Vexcel imagery API. Sent as the X-API-KEY header. Houston and Los Angeles only.
VEXCEL_API_KEY=

# CoStar data kit: a password-protected zip.
# Set the password, plus either the download link or the path to the downloaded zip.
COSTAR_ZIP_PASSWORD=
COSTAR_KIT_URL=
COSTAR_KIT_ZIP=

# LangSmith tracing for the agent: traces go to agent "robots", environment "local".
# Do not also set LANGSMITH_PROJECT (or LANGCHAIN_PROJECT): with both a project and
# an agent address in the environment, the SDK traces nothing.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=robots
LANGSMITH_AGENT_ENVIRONMENT=local

# Claude, for the model steps of both agents (python -m agent.run and python -m agent.design_flow). Uncomment and fill in; an empty value
# blocks the SDK's other credential sources.
# ANTHROPIC_API_KEY=