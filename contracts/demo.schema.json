{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.robots.invalid/demo.schema.json",
  "title": "demo.json: one demonstration's hand poses",
  "description": "Hand joint poses from Quest hand tracking (WebXR Hand Input, 25 joints per hand), recorded once at home on the real object. Stored relative to the object, so the demo can be reused wherever that object appears. Fingertip forces are in grip.json, on their own clock. Written by C (capture). Read by A (requirements, program) and B (motion.retarget).",
  "type": "object",
  "required": ["header", "demo_id", "task_id", "object", "device", "hands", "phases", "sync"],
  "properties": {
    "header": { "$ref": "common.schema.json#/$defs/header" },
    "demo_id": { "$ref": "common.schema.json#/$defs/id" },
    "task_id": { "$ref": "common.schema.json#/$defs/id", "description": "The task in requirements.json this demo answers." },
    "operator": { "type": "string", "description": "Who demonstrated. A handle, not a full name." },
    "recorded_at": { "type": "string", "format": "date-time" },
    "object": {
      "type": "object",
      "required": ["object_class", "frame", "pose_in_capture"],
      "properties": {
        "object_class": { "type": "string", "description": "Same vocabulary as requirements tasks[].target.object_class." },
        "description": { "type": "string", "description": "e.g. 60 W A19 bulb, E26 base, frosted glass." },
        "frame": { "type": "string", "pattern": "^object:[a-z0-9_.-]+$", "description": "The frame every joint pose below is in." },
        "pose_in_capture": { "$ref": "common.schema.json#/$defs/pose", "description": "Where the object frame sat in the Quest's local-floor space. Frame must be capture." },
        "how_located": { "enum": ["marker", "controller_touch", "manual"] },
        "dimensions_m": { "$ref": "common.schema.json#/$defs/vec3_m", "description": "Bounding box, x y z." },
        "mass_kg": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "required": ["headset", "tracking", "glove_id"],
      "properties": {
        "headset": { "type": "string", "description": "e.g. Meta Quest 3" },
        "tracking": { "const": "webxr-hand-input" },
        "browser": { "type": "string" },
        "glove_id": { "$ref": "common.schema.json#/$defs/id", "description": "Matches grip.json and calibration.json." }
      },
      "additionalProperties": false
    },
    "hands": {
      "type": "object",
      "required": ["rate_hz", "joint_names", "joint_layout", "frames"],
      "properties": {
        "rate_hz": { "type": "number", "exclusiveMinimum": 0, "description": "Nominal; t_s on each frame is the truth." },
        "joint_names": {
          "description": "WebXR Hand Input joint order. Each frame's joint array follows this order.",
          "const": [
            "wrist",
            "thumb-metacarpal", "thumb-phalanx-proximal", "thumb-phalanx-distal", "thumb-tip",
            "index-finger-metacarpal", "index-finger-phalanx-proximal", "index-finger-phalanx-intermediate", "index-finger-phalanx-distal", "index-finger-tip",
            "middle-finger-metacarpal", "middle-finger-phalanx-proximal", "middle-finger-phalanx-intermediate", "middle-finger-phalanx-distal", "middle-finger-tip",
            "ring-finger-metacarpal", "ring-finger-phalanx-proximal", "ring-finger-phalanx-intermediate", "ring-finger-phalanx-distal", "ring-finger-tip",
            "pinky-finger-metacarpal", "pinky-finger-phalanx-proximal", "pinky-finger-phalanx-intermediate", "pinky-finger-phalanx-distal", "pinky-finger-tip"
          ]
        },
        "joint_layout": {
          "description": "What the eight numbers per joint are. Position in metres, orientation unit quaternion scalar first, radius from XRJointPose.radius.",
          "const": ["x_m", "y_m", "z_m", "qw", "qx", "qy", "qz", "radius_m"]
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["t_s", "left", "right"],
            "properties": {
              "t_s": { "type": "number", "minimum": 0, "description": "Seconds since recording start, on the headset clock." },
              "left": { "$ref": "#/$defs/hand_sample" },
              "right": { "$ref": "#/$defs/hand_sample" }
            },
            "additionalProperties": false
          }
        },
        "frames_file": { "$ref": "common.schema.json#/$defs/file_ref", "description": "Optional: the same frames as a binary sidecar for long demos. frames then holds a downsampled preview." }
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "description": "The demo cut into skill phases. motion.retarget uses these; grip.json bands use the same names.",
      "items": {
        "type": "object",
        "required": ["phase_id", "skill", "t_start_s", "t_end_s"],
        "properties": {
          "phase_id": { "$ref": "common.schema.json#/$defs/id" },
          "skill": { "$ref": "common.schema.json#/$defs/skill" },
          "step_id": { "$ref": "common.schema.json#/$defs/id", "description": "The requirements step this phase demonstrates." },
          "t_start_s": { "type": "number", "minimum": 0 },
          "t_end_s": { "type": "number", "minimum": 0 },
          "hand": { "enum": ["left", "right", "both"] },
          "how_segmented": { "enum": ["manual", "force_threshold", "auto"] }
        },
        "additionalProperties": false
      }
    },
    "sync": {
      "type": "object",
      "required": ["glove_offset_s", "method"],
      "description": "glove_time = headset_time + glove_offset_s.",
      "properties": {
        "glove_offset_s": { "type": "number" },
        "method": { "enum": ["tap_event", "shared_clock", "manual"] },
        "residual_s": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "tracked_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hand_sample": {
      "type": "object",
      "required": ["tracked"],
      "properties": {
        "tracked": { "type": "boolean" },
        "joints": {
          "type": "array",
          "minItems": 25,
          "maxItems": 25,
          "items": { "type": "array", "items": { "type": "number" }, "minItems": 8, "maxItems": 8 }
        }
      },
      "if": { "properties": { "tracked": { "const": true } } },
      "then": { "required": ["tracked", "joints"] },
      "additionalProperties": false
    }
  }
}
