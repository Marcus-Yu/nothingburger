{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "design",
 "type": "object",
 "required": [
  "schema",
  "parts",
  "price_usd",
  "mass_kg",
  "checks",
  "labels"
 ],
 "properties": {
  "schema": {
   "const": "design/1"
  },
  "parts": {
   "anyOf": [
    {
     "type": "object",
     "required": [
      "base",
      "lift",
      "arm",
      "gripper",
      "lidar",
      "lidar_mount",
      "wrist_cam",
      "ego_cam"
     ],
     "properties": {
      "wrist_cam": {
       "type": "boolean"
      }
     }
    },
    {
     "type": "null"
    }
   ]
  },
  "checks": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "check",
     "status",
     "requirements"
    ],
    "properties": {
     "check": {
      "type": "string"
     },
     "task": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "enum": [
       "pass",
       "fail",
       "not_assessable",
       "not_run"
      ]
     },
     "requirements": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "infeasible": {
   "type": "object",
   "required": [
    "binding_checks"
   ]
  }
 }
}
