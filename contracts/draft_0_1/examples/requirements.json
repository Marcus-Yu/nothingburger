  "tasks": [
    {
      "task_id": "bulb",
      "request_text": "Can it swap the bulb in the hallway ceiling light when it burns out?",
      "job": "change_light_bulb",
      "priority": 1,
      "frequency": "on request",
      "target": {
        "object_class": "a19_bulb",
        "object_id": "fixture-hall-ceiling-1",
        "room_id": "hallway-1",
        "world": {
          "file": "world.json",
          "pointer": "/fixtures/0"
        }
      },
      "steps": [
        {
          "step_id": "go",
          "text": "Drive to below the hallway ceiling light.",
          "skill": "navigate"
        },
        {
          "step_id": "reach",
          "text": "Raise the gripper to the bulb.",
          "skill": "reach"
        },
        {
          "step_id": "grasp",
          "text": "Grip the old bulb firmly enough not to slip, gently enough not to crack it.",
          "skill": "grasp",
          "needs_demo": true
        },
        {
          "step_id": "unscrew",
          "text": "Turn the bulb counter-clockwise about three turns until it is free.",
          "skill": "twist",
          "needs_demo": true,
          "params": {
            "turns": 3,
            "direction": "ccw"
          }
        },
        {
          "step_id": "lower",
          "text": "Lower the old bulb and put it in the tray.",
          "skill": "place"
        },
        {
          "step_id": "inspect",
          "text": "Look into the empty socket for scorch marks, broken glass or a bent contact; if there are any, stop and tell the landlord.",
          "skill": "inspect",
          "inspection": {
            "target": "empty E26 socket and fixture cup",
            "sensor": "rgb_camera",
            "look_for": [
              "scorch_mark",
              "broken_glass_in_socket",
              "bent_contact",
              "loose_fixture"
            ],
            "standoff_m": 0.15,
            "min_resolution_mm": 0.5,
            "views": 2,
            "on_finding": "ask_human",
            "report": "socket_findings"
          }
        }
      ],
      "success_criteria": [
