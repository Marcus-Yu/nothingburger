{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.robots.invalid/signals.schema.json",
  "title": "signals.json: what the simulation measured",
  "description": "Every metric the program, its tests and the success criteria name, as recorded by the MuJoCo run of program.json. Everything here is simulated and is never reported as a fact about a real building or real hardware. verdict.json is computed from these. Written by B (sim). Read by A (verdict review, report) and C (force plot, replay).",
  "type": "object",
  "required": [
    "header",
    "program_id",
    "provenance",
    "sim",
    "signals"
  ],
  "properties": {
    "header": {
      "$ref": "common.schema.json#/$defs/header"
    },
    "program_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "provenance": {
      "const": "simulated"
    },
    "sim": {
      "type": "object",
      "description": "Enough to rerun it and get the same numbers.",
      "required": [
        "engine",
        "engine_version",
        "timestep_s",
        "seed",
        "scene",
        "robot"
      ],
      "properties": {
        "engine": {
          "const": "mujoco"
        },
        "engine_version": {
          "type": "string"
        },
        "timestep_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "seed": {
          "type": "integer"
        },
        "scene": {
          "$ref": "common.schema.json#/$defs/file_ref",
          "description": "The MJCF scene: building mesh plus props."
        },
        "robot": {
          "$ref": "common.schema.json#/$defs/file_ref",
          "description": "robot.xml as run."
        },
        "wall_time_s": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/signal"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "signal": {
      "type": "object",
      "description": "One metric over one step (or the whole task when step_id is absent). The name's unit suffix must match units: _N is N, _m is m, _rad is rad, _s is s, _turns is turns, _count is count; a name with no suffix is bool, count or fraction.",
      "required": [
        "name",
        "units",
        "kind",
        "task_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*?(_N)?$"
        },
        "units": {
          "enum": [
            "N",
            "m",
            "rad",
            "turns",
            "s",
            "count",
            "bool",
            "fraction"
          ]
        },
        "kind": {
          "enum": [
            "timeseries",
            "scalar",
            "findings"
          ]
        },
        "task_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "step_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "t_s": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "description": "Run time, seconds from program start."
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "One per t_s. bool is 0 or 1."
        },
        "value": {
          "type": "number"
        },
        "series_file": {
          "$ref": "common.schema.json#/$defs/file_ref",
          "description": "Full-rate series as a binary sidecar; t_s and values then hold a preview. Aggregates are computed from the inline preview, so it must keep each step's extremes and final sample."
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "synthetic": {
          "type": "boolean",
          "description": "true when the input was made up for the test, e.g. a defect painted onto the sim mesh. Findings from sim are always synthetic."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "timeseries"
              }
            }
          },
          "then": {
            "required": [
              "t_s",
              "values"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "scalar"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "findings"
              }
            }
          },
          "then": {
            "required": [
              "findings",
              "synthetic"
            ],
            "properties": {
              "units": {
                "const": "count"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "defect_class",
        "confidence",
        "view",
        "image"
      ],
      "properties": {
        "defect_class": {
          "type": "string",
          "description": "One of the step's inspection.look_for."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "view": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "common.schema.json#/$defs/file_ref"
        },
        "location_m": {
          "$ref": "common.schema.json#/$defs/vec3_m",
          "description": "World frame."
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
